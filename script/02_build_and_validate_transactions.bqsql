-- ============================================================
-- Build and validate the cleaned transactions table
-- ============================================================
-- Source: `amlnet.transactions_raw_fixed`
-- Target: `amlnet.transactions`
--
-- This script:
--   1. defines the cleaned transaction schema;
--   2. populates the table from the repaired raw source; and
--   3. verifies that the stored rows exactly match the intended
--      transformation, including duplicate multiplicities.
-- ============================================================


-- ============================================================
-- 1. Create cleaned transactions table
-- ============================================================
-- transaction_id is a generated surrogate key for the cleaned table.
-- BigQuery primary-key constraints are informational rather than enforced,
-- while the identity definition itself generates unique, non-null values.

CREATE OR REPLACE TABLE `amlnet.transactions` (
    transaction_id INT64 GENERATED ALWAYS AS IDENTITY(),

    transaction_timestamp TIMESTAMP NOT NULL,
    transaction_date DATE NOT NULL,

    transaction_type STRING NOT NULL,
    transaction_category STRING NOT NULL,
    amount NUMERIC NOT NULL,

    origin_id STRING NOT NULL,
    destination_id STRING NOT NULL,
    origin_balance_before NUMERIC NOT NULL,
    origin_balance_after NUMERIC NOT NULL,

    state STRING NOT NULL,
    city STRING NOT NULL,
    postcode STRING NOT NULL,

    device_type STRING NOT NULL,
    device_os STRING NOT NULL,
    payment_method STRING NOT NULL,

    -- Merchant information is not present for every transaction.
    merchant_id STRING,
    merchant_risk_level STRING,
    merchant_avg_transaction NUMERIC,

    label_is_fraud BOOL NOT NULL,
    label_is_money_laundering BOOL NOT NULL,
    label_laundering_typology STRING,

    provided_fraud_probability NUMERIC,

    PRIMARY KEY (transaction_id) NOT ENFORCED
);


-- ============================================================
-- 2. Populate cleaned transactions table
-- ============================================================
-- The INSERT column order must correspond exactly to the SELECT expression
-- order below.
--
-- Transformations applied here:
--   - parse the repaired metadata timestamp and derive transaction_date;
--   - cast monetary/balance fields from FLOAT64 to NUMERIC;
--   - extract selected location, device, payment, and merchant attributes
--     from the native JSON metadata column; and
--   - retain the supplied fraud and money-laundering labels.

INSERT INTO `amlnet.transactions` (
    transaction_timestamp,
    transaction_date,
    transaction_type,
    transaction_category,
    amount,
    origin_id,
    destination_id,
    origin_balance_before,
    origin_balance_after,
    state,
    city,
    postcode,
    device_type,
    device_os,
    payment_method,
    merchant_id,
    merchant_risk_level,
    merchant_avg_transaction,
    label_is_fraud,
    label_is_money_laundering,
    label_laundering_typology,
    provided_fraud_probability
)
SELECT
    SAFE_CAST(
        JSON_VALUE(metadata, '$.timestamp')
        AS TIMESTAMP
    ),
    DATE(
        SAFE_CAST(
            JSON_VALUE(metadata, '$.timestamp')
            AS TIMESTAMP
        )
    ),
    type,
    category,
    CAST(amount AS NUMERIC),
    nameOrig,
    nameDest,
    CAST(oldbalanceOrg AS NUMERIC),
    CAST(newbalanceOrig AS NUMERIC),
    JSON_VALUE(metadata, '$.location.state'),
    JSON_VALUE(metadata, '$.location.city'),
    JSON_VALUE(metadata, '$.location.postcode'),
    JSON_VALUE(metadata, '$.device_info.type'),
    JSON_VALUE(metadata, '$.device_info.os'),
    JSON_VALUE(metadata, '$.payment_method'),
    JSON_VALUE(metadata, '$.merchant_info.merchant_id'),
    JSON_VALUE(metadata, '$.merchant_info.risk_level'),
    SAFE_CAST(
        JSON_VALUE(metadata, '$.merchant_info.avg_transaction')
        AS NUMERIC
    ),
    isFraud,
    isMoneyLaundering,
    laundering_typology,
    fraud_probability
FROM `amlnet.transactions_raw_fixed`;


-- ============================================================
-- 3. Validate transformed table contents
-- ============================================================
-- Reconstruct the rows that should exist in `amlnet.transactions` from the
-- source table, then compare them with the rows actually stored.
--
-- transaction_id is excluded because it is generated by the destination
-- table and therefore has no corresponding source value.
--
-- Identical full rows are grouped and counted on both sides. This preserves
-- duplicate multiplicities rather than comparing only distinct row values.
-- The FULL OUTER JOIN then exposes rows that are missing, extra, or present
-- a different number of times.
--
-- Expected result: zero rows. Any returned row represents a discrepancy.

WITH expected AS (
    -- Reconstruct the intended cleaned representation of every source row.
    SELECT
        SAFE_CAST(
            JSON_VALUE(metadata, '$.timestamp')
            AS TIMESTAMP
        ) AS transaction_timestamp,
        DATE(
            SAFE_CAST(
                JSON_VALUE(metadata, '$.timestamp')
                AS TIMESTAMP
            )
        ) AS transaction_date,
        type AS transaction_type,
        category AS transaction_category,
        CAST(amount AS NUMERIC) AS amount,
        nameOrig AS origin_id,
        nameDest AS destination_id,
        CAST(oldbalanceOrg AS NUMERIC) AS origin_balance_before,
        CAST(newbalanceOrig AS NUMERIC) AS origin_balance_after,
        JSON_VALUE(metadata, '$.location.state') AS state,
        JSON_VALUE(metadata, '$.location.city') AS city,
        JSON_VALUE(metadata, '$.location.postcode') AS postcode,
        JSON_VALUE(metadata, '$.device_info.type') AS device_type,
        JSON_VALUE(metadata, '$.device_info.os') AS device_os,
        JSON_VALUE(metadata, '$.payment_method') AS payment_method,
        JSON_VALUE(metadata, '$.merchant_info.merchant_id') AS merchant_id,
        JSON_VALUE(metadata, '$.merchant_info.risk_level')
            AS merchant_risk_level,
        SAFE_CAST(
            JSON_VALUE(
                metadata,
                '$.merchant_info.avg_transaction'
            )
            AS NUMERIC
        ) AS merchant_avg_transaction,
        isFraud AS label_is_fraud,
        isMoneyLaundering AS label_is_money_laundering,
        laundering_typology AS label_laundering_typology,
        fraud_probability AS provided_fraud_probability
    FROM `amlnet.transactions_raw_fixed`
),

actual AS (
    -- Select the corresponding stored columns in the same order.
    SELECT
        transaction_timestamp,
        transaction_date,
        transaction_type,
        transaction_category,
        amount,
        origin_id,
        destination_id,
        origin_balance_before,
        origin_balance_after,
        state,
        city,
        postcode,
        device_type,
        device_os,
        payment_method,
        merchant_id,
        merchant_risk_level,
        merchant_avg_transaction,
        label_is_fraud,
        label_is_money_laundering,
        label_laundering_typology,
        provided_fraud_probability
    FROM `amlnet.transactions`
),

expected_counts AS (
    -- Represent each complete expected row as one grouping key and preserve
    -- how many times that row occurs.
    SELECT
        TO_JSON_STRING(e) AS row_value,
        COUNT(*) AS n_expected
    FROM expected AS e
    GROUP BY row_value
),

actual_counts AS (
    -- Apply the same full-row frequency count to the stored table.
    SELECT
        TO_JSON_STRING(a) AS row_value,
        COUNT(*) AS n_actual
    FROM actual AS a
    GROUP BY row_value
)

-- Return only row values whose expected and actual frequencies differ.
SELECT
    COALESCE(e.row_value, a.row_value) AS row_value,
    COALESCE(e.n_expected, 0) AS n_expected,
    COALESCE(a.n_actual, 0) AS n_actual
FROM expected_counts AS e
FULL OUTER JOIN actual_counts AS a
USING (row_value)
WHERE
    COALESCE(e.n_expected, 0)
    != COALESCE(a.n_actual, 0);

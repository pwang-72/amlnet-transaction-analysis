-- AMLNet | Flagged-account transaction network
--
-- Purpose:
--   Build a directed edge table for exploring the transaction networks of
--   accounts that appear in at least one fraud- or money-laundering-labelled
--   transaction.
--
-- Scope and interpretation:
--   * Retain BOTH flagged and unflagged transactions involving these accounts,
--     so the network shows their broader transaction relationships.
--   * A "flagged account" means an account involved in a labelled transaction;
--     it does not imply the account itself committed fraud or money laundering.
--   * Edges are aggregated by focal account, counterparty, transaction direction,
--     and transaction flag. If both endpoints are flagged-involved, the same
--     transaction can contribute to two focal-account views.
--   * source_id and target_id always describe the actual money-flow direction
--     (origin -> destination), regardless of the focal account's role.
--
-- Output: amlnet.flagged_account_connections
-- Grain:  one row per entity_id, counterpart_id, transaction_role, flagged.

CREATE OR REPLACE TABLE `amlnet.flagged_account_connections` AS

WITH `flagged accounts` AS (
    -- Collect both endpoints of every labelled transaction.
    -- UNION DISTINCT removes repeated account IDs across the two roles.
    SELECT origin_id AS entity_id
    FROM `amlnet.transactions`
    WHERE label_is_fraud OR label_is_money_laundering

    UNION DISTINCT

    SELECT destination_id
    FROM `amlnet.transactions`
    WHERE label_is_fraud OR label_is_money_laundering

),
entity_transactions AS (
    -- Build two account-centric views of transactions:
    -- 'origin' = the focal account sends; 'destination' = it receives.
    -- Retain all transactions involving flagged-involved focal accounts,
    -- not only transactions whose flagged value is TRUE.
    SELECT
        entity_id,
        counterpart_id,
        SUM(amount) AS total_amount,
        transaction_role,
        flagged
    FROM (
        -- Outgoing activity for accounts involved in labelled transactions.
        SELECT
            origin_id AS entity_id,
            destination_id AS counterpart_id,
            amount,
            'origin' AS transaction_role,
            label_is_fraud OR label_is_money_laundering AS flagged
        FROM `amlnet.transactions`
        WHERE origin_id IN (
            SELECT entity_id
            FROM `flagged accounts`
        )

        UNION ALL

        -- Incoming activity for accounts involved in labelled transactions.
        -- UNION ALL preserves each focal-account view before aggregation.
        SELECT
            destination_id AS entity_id,
            origin_id AS counterpart_id,
            amount,
            'destination' AS transaction_role,
            label_is_fraud OR label_is_money_laundering AS flagged
        FROM `amlnet.transactions`
        WHERE destination_id IN (
            SELECT entity_id
            FROM `flagged accounts`
        )
    )
    -- Keep opposite directions and flagged/unflagged amounts separate
    -- between the same pair of accounts.
    GROUP BY entity_id, counterpart_id, transaction_role, flagged
)

SELECT
    *,
    -- Express every aggregated relationship as a directed graph edge,
    -- even when the focal account is the receiver.
    CASE
        WHEN transaction_role = 'origin' THEN entity_id
        ELSE counterpart_id
    END AS source_id,
    CASE
        WHEN transaction_role = 'destination' THEN entity_id
        ELSE counterpart_id
    END AS target_id
FROM entity_transactions;
